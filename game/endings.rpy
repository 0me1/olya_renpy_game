label finish_ending:
    $ unlock_ending(current_ending)
    call ending_scene
    if current_ending == "home" and bonus_available():
        menu:
            "Оставить дверь открытой — увидеть бонусный эпилог":
                $ current_ending = "open_door"
                $ unlock_ending(current_ending)
                call ending_scene
            "Завершить этот вечер дома":
                pass
    call screen ending_result(current_ending)
    return

label ending_scene:
    if current_ending == "stay_housewives":
        $ enter_world("housewives")
        scene bg wisteria_kitchen
        show olya housewives relief at left_actor
        show bree base at right_actor
        with fade
        "На первом собственном празднике Оля поставила пирог посередине стола. Не так, как вчера показала Бри. По-своему. Потом оглядела кухню и решила оставить именно так."
        if ending_choice("housewives", "solution") == "honest":
            $ cast_pose("bree", "approving")
            bree "Я предупредила гостей, что время может немного измениться. Заранее. Это оказалось удивительно спокойно."
            "Сьюзан принесла записку с одним обещанием вместо пяти. Они посмеялись, но не стали превращать вчерашний разговор в вечную историю о ее ошибке."
        elif ending_choice("housewives", "solution") == "cover":
            "Рядом с тарелками лежал маленький список звонков. На этот раз Сьюзан взяла половину сама. Некоторые удобные решения начинались хитростью, а продолжались совершенно честной работой."
        else:
            "Каждый принес что-то свое: блюдо, цветы, смешную историю, помощь с посудой. Никому не пришлось догадываться, чего от него ждали. Оля заранее написала это в приглашении."
        hide bree
        show susan base at right_actor
        $ cast_pose("susan", "relieved")
        susan "Ты точно больше никого не ждешь?"
        o "Жду. Но если кто-то опоздает, мы не будем остывать вместе с пирогом."
        "Заявление лежало в ящике стола. В графе назначения значилась эта улица, а внизу стояла подпись Оли. Оно больше не предлагало следующего адреса."
        "Вечером они сидели на крыльце. Соседские окна светились по одному. Оля не знала всех будущих историй этой улицы и не обязана была знать. Для начала ей хватало своего места за столом."
        "Она осталась не потому, что дверь закрылась. Она решила распаковать здесь свой день."
    elif current_ending == "stay_manhattan":
        $ enter_world("manhattan")
        scene bg manhattan_bar
        show olya manhattan happy at left_actor
        with fade
        "Через неделю Оля назначила встречу сама. В приглашении было одно место, одно время и честное «если вам удобно». Эта короткая фраза неожиданно сделала подготовку легче."
        if ending_choice("manhattan", "solution") == "terms":
            "Она заранее выбрала час для встречи, не пытаясь уместить в него весь город. Когда час закончился, можно было продолжить — уже новым решением, а не незаметно продленным обязательством."
        elif ending_choice("manhattan", "solution") == "refuse":
            "На один из звонков она ответила отказом без длинной защиты своего права устать. Собеседник нашел другой вариант, а Оля наконец перестала репетировать разговор после его окончания."
        else:
            "Двое знакомых пришли вместе. Теперь они организовали часть вечера сами. Оля с удовольствием заметила, что может просто слушать, не переводя каждую паузу в следующее дело."
        $ cast_pose("carrie", "neutral")
        carrie "Какой план?"
        o "Сначала выберем, чего хочется. Потом посмотрим, нужен ли план."
        $ cast_pose("miranda", "explaining")
        miranda "Запишу. Только не как обязательство на следующие шесть месяцев."
        "За окном начинался дождь. Оля не спешила заказывать такси ради следующего адреса. У нее был зонт, разговор и вечер, которому не требовалось выглядеть впечатляюще со стороны."
        "Дома на столе лежало завершенное заявление. Иногда оно служило закладкой. Это оказалось очень достойным занятием для бумаги, которая когда-то хотела распорядиться целой жизнью."
    elif current_ending == "stay_southpark":
        $ enter_world("southpark")
        scene bg southpark_school
        show olya southpark neutral at left_actor
        with fade
        "В первый рабочий день к Оле принесли обращение: жители просили разобраться с обязательным добровольным выходным. К обращению прилагался график дежурств на время отдыха."
        o "Давайте начнем с названия. Оно у вас уже спорит само с собой."
        if ending_choice("southpark", "solution") == "public":
            "На стене теперь висело правило: противоречащие объявления читают вместе. Автор объявления тоже присутствует. Некоторые проекты после этого удивительно быстро становились короче."
        elif ending_choice("southpark", "solution") == "demo":
            "У комиссии появился испытательный стол. Любое громкое нововведение сначала оставляли на нем рядом с телефоном автора. Это не решило всех проблем, зато уменьшило их громкость."
        else:
            "Оля завела общий календарь. В первый же день Рэнди предложил торжественное открытие календаря, а Кайл спросил, внесено ли оно в сам календарь. Работа сразу пошла по существу."
        $ cast_pose("cartman", "proud")
        cartman "У меня есть премиум-папка для обращений. Без нее они будут лежать просто в папке."
        o "Какое удачное описание бесплатного варианта. Берем его."
        "Кайл засмеялся. Рэнди положил на стол еще одно предложение, на этот раз карандашом. Оля открыла окно: на улице было спокойно ровно настолько, чтобы услышать следующий нелепый вопрос."
        "Она не стала единственным нормальным человеком в городе. Просто нашла место, где ее вопросы приносили пользу, а ответы иногда стоили отдельной истории."
    elif current_ending == "stay_minecraft":
        $ enter_world("minecraft")
        scene bg minecraft_house
        show olya minecraft pickaxe at left_actor
        with fade
        "Утром Оля открыла дверь и несколько секунд просто смотрела на свет. Вчера утро было целью. Теперь оно стало началом дня, в котором не нужно было срочно искать следующую дверь."
        if ending_choice("minecraft", "resource") == "base":
            "Она подняла потолок на один блок и расширила окно. Дом перестал быть укрытием, построенным от страха, и начал становиться местом, которое удобно выбирать."
        else:
            "Житель показал свободный участок рядом с деревней. Оля перенесла туда запасные доски и посадила семечко, которое все это время берегла в кармане."
        if ending_choice("minecraft", "solution") == "trade":
            "К вечеру они вместе починили вторую калитку. Обмен больше не требовал длинных объяснений: каждый знал, чем может помочь и что оставить для себя."
        else:
            "Оля собрала еще одну небольшую раму, уже без перехода. Получилась полка. Не всякая уверенно стоящая конструкция обязана вести в другой мир."
        o "Сегодня сделаю стол. Завтра решу, что на него поставить. Очень перспективный порядок действий."
        "За окном прошла овца. На этот раз Оля не вздрогнула. Ночь все еще могла быть опасной, но у нее были свет, дверь и опыт возвращения к ним."
        "Завершенное заявление висело рядом с чертежом. Квадратная подпись выглядела непривычно, зато была совершенно ее собственной."
    elif current_ending == "stay_sims":
        $ enter_world("sims")
        scene bg sims_home
        show olya sims happy at left_actor
        with fade
        "Оля проснулась и первым делом не стала ничего покупать. Это не было великим достижением, но три торшера у стены явно одобряли разумную паузу."
        if ending_choice("sims", "solution") == "observe":
            "Она составила короткий список полезных подсказок. Все остальное можно было заметить, обдумать и не выполнять. В списке осталось место для новых решений."
        elif ending_choice("sims", "solution") == "redesign":
            "Кухня наконец работала так, как выглядела. Тарелки не отправлялись в путешествие до ванной, а разговоры помещались в вечер, не требуя обходить лишнюю мебель."
        else:
            "Очередь над головой была пустой. Оля сама добавила завтрак, прогулку и разговор с Беллой. Потом убрала прогулку: пошел дождь. Мир выдержал это изменение."
        $ cast_pose("bella", "greeting")
        bella "Что будем делать сегодня?"
        o "Сначала чай. Остальное я пока не обязана знать."
        "Они убрали два лишних торшера. Третий оставили: он действительно хорошо освещал кресло. Выбрать самой оказалось не тем же самым, что отвергнуть все предложенное."
        "Под вечер появилась новая внешняя команда. Оля спокойно отменила ее и вернулась к незаконченной фразе. День не стал идеальным, зато перестал быть чужой очередью."
    elif current_ending == "stay_marvel":
        $ enter_world("marvel")
        scene bg marvel_hall
        show olya marvel neutral at left_actor
        with fade
        "В восемь пятьдесят пять Оля пришла в зал. На столе лежали чистый лист, карандаш и записка Вонга: «Сначала чай. Потом пространство»."
        if ending_choice("marvel", "solution") == "test":
            "Она начала с маленькой двери. Открыла, закрыла, проверила край. На этот раз упражнение не было доказательством храбрости — просто способом научиться полезному делу."
        else:
            "Она проверила опоры учебного прохода. Каждая отметка требовала внимания, и именно это делало занятие спокойным. Здесь осторожность не называли недостатком способностей."
        $ cast_pose("strange", "explaining")
        strange "Сегодня попробуем удержать направление."
        o "Давайте без внезапных полетов на крышу. У меня там не сложились отношения с первым впечатлением."
        $ cast_pose("wong", "approving")
        wong "Уже внесено в программу. После чая."
        "Старое заявление хранилось в архиве с пометкой «Маршрут завершен владельцем». Оля оставила себе копию. Не как пропуск в новую жизнь, а как напоминание, что завершать иногда значит просто выбрать."
        "Никто не требовал немедленно стать великой волшебницей. Завтра нужно было прийти к девяти. Этого было достаточно, чтобы у необычного будущего появился уютный, вполне обычный край."
    elif current_ending == "home":
        $ enter_world("office")
        play music "audio/music/office_airport_lounge.ogg" volume 0.25 fadein 1.5
        scene bg office_evening
        show olya office sleepy at center_actor
        with fade
        "Оля открыла глаза за своим столом. Ладонь лежала на бумаге, часы тикали, а в коридоре кто-то осторожно прошел мимо двери. Плечо затекло самым обыкновенным образом."
        o "Все-таки посидела."
        "На заявлении было написано: «Место назначения — домой». Ни адреса чужого города, ни следующего поручения. Внизу стояла ее подпись."
        "Она убрала папку, погасила настольную лампу и не стала искать еще одно дело, которое обязательно надо закончить сегодня. Вечер за окном был не пустым — свободным."
        scene bg birthday_home
        show olya office happy at left_actor
        with fade
        "Дома праздничный свет встретил Олю уже по другую сторону рабочего дня. В телефоне одно за другим открывались теплые сообщения. Без выдуманного прошлого, без обязательных больших слов — просто от людей, которым она дорога."
        friends "Оля, с днем рождения! Пусть у тебя будет время на то, что радует, силы на то, что важно, и возможность спокойно сказать: сегодня я выбираю вот это."
        friends "Пусть хорошие люди оказываются рядом не только в трудный момент. Пусть смешные истории случаются чаще неприятных поручений. И пусть обычный день иногда приятно удивляет."
        friends "Желаем тебе любопытства без вечной спешки, отдыха без чувства вины и планов, которые можно менять. Не нужно успевать все, чтобы твой день был хорошим."
        o "Спасибо. Кажется, у меня как раз появился некоторый опыт изменения планов."
        "Она улыбнулась. За окном был знакомый мир, в котором еще оставалось много неизвестного. Возвращение не отменяло ни одной из встреч и не делало другие дороги ошибкой. Сегодня Оля выбрала быть здесь."
    elif current_ending == "open_door":
        $ enter_world("office")
        play music "audio/music/office_airport_lounge.ogg" volume 0.25 fadein 1.5
        scene bg office_evening
        show olya office happy at center_actor
        with fade
        "Несколько дней спустя Оля открыла ящик стола. Заявление лежало там спокойно. На обороте появилась маленькая дверь — та самая, которую она теперь узнавала без испуга."
        "Рядом было восемь коротких слов: «Можно вернуться. Можно пойти дальше. Можно остаться дома». Ни срока, ни обязательной явки."
        o "Вот так мне нравится гораздо больше."
        "Она не стала немедленно собираться. Сначала закончила чай. Потом подумала, не взять ли в следующий раз пирог. Самостоятельно выбранный пирог, без секретного письма под формой."
        "За окном шел обычный вечер. На Вистерия-Лейн тоже зажигались окна, где-то шумел город, хрустел снег, росли квадратные грядки. Все шесть миров оставались возможными."
        "Оля закрыла ящик. Дверь никуда не делась. Хорошие возможности умеют подождать, пока им скажут настоящее «да»."
    return
